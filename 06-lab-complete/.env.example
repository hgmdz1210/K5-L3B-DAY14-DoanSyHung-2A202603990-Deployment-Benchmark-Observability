# Dùng: cp .env.example .env  rồi điền AGENT_API_KEY (file .env đã nằm trong .gitignore).
# Không ghi secret thật vào file này.

PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Bắt buộc. Để trống thì mọi request tới /ask bị trả 401.
# Tạo key ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# docker compose tự ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
